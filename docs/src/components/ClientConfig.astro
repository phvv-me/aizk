---
import { Code } from '@astrojs/starlight/components';
import { publicOAuthClientId } from '../config/deployment';
import { setupFor } from '../config/setup';

interface Props {
  client: 'claude-code' | 'codex' | 'opencode';
  shared?: boolean;
}

const { client, shared = false } = Astro.props;
const site = (Astro.site?.origin ?? 'https://aizk.example.com').replace(/\/$/, '');
const endpoint = `${site}/mcp`;
const clientId = publicOAuthClientId();
const claude = setupFor('claude-code');
const codex = setupFor('codex');

const configurations = {
  'claude-code': shared
    ? {
        lang: 'json',
        code: `{
  "mcpServers": {
    "aizk": {
      "type": "http",
      "url": "${endpoint}",
      "oauth": {
        "clientId": "${clientId}",
        "callbackPort": 8912
      }
    }
  }
}`,
      }
    : {
        lang: 'sh',
        code: `${claude.install}\n${claude.connect}`,
      },
  codex: {
    lang: 'sh',
    code: `${codex.install}\n${codex.connect}`,
  },
  opencode: {
    lang: 'json',
    code: `{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aizk": {
      "type": "remote",
      "url": "${endpoint}",
      "oauth": {
        "clientId": "${clientId}",
        "scope": "control offline_access openid",
        "callbackPort": 8912,
        "redirectUri": "http://127.0.0.1:8912/callback"
      },
      "enabled": true
    }
  }
}`,
  },
};

const configuration = configurations[client];
---

<Code code={configuration.code} lang={configuration.lang} />
