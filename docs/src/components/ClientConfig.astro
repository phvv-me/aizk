---
import { Code } from '@astrojs/starlight/components';

interface Props {
  client: 'claude-code' | 'codex' | 'opencode';
  shared?: boolean;
}

const { client, shared = false } = Astro.props;
const site = (Astro.site?.origin ?? 'https://aizk.example.com').replace(/\/$/, '');
const endpoint = `${site}/mcp`;
const clientId = import.meta.env.AIZK_DOCS_MCP_CLIENT_ID ?? 'PUBLIC_AIZK_CLIENT_ID';

const configurations = {
  'claude-code': shared
    ? {
        lang: 'json',
        code: `{
  "mcpServers": {
    "aizk": {
      "type": "http",
      "url": "${endpoint}",
      "oauth": {
        "clientId": "${clientId}",
        "callbackPort": 8912
      }
    }
  }
}`,
      }
    : {
        lang: 'sh',
        code: `claude mcp add --scope user --transport http --client-id ${clientId} \\
  --callback-port 8912 aizk ${endpoint}
claude mcp login aizk`,
      },
  codex: {
    lang: 'toml',
    code: `mcp_oauth_credentials_store = "file"
mcp_oauth_callback_port = 8912

[features]
mcp_2026_07_28 = true

[mcp_servers.aizk]
url = "${endpoint}"
auth = "oauth"
scopes = ["control", "offline_access", "openid"]

[mcp_servers.aizk.oauth]
client_id = "${clientId}"`,
  },
  opencode: {
    lang: 'json',
    code: `{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aizk": {
      "type": "remote",
      "url": "${endpoint}",
      "oauth": {
        "clientId": "${clientId}",
        "scope": "control offline_access openid",
        "callbackPort": 8912,
        "redirectUri": "http://127.0.0.1:8912/callback"
      },
      "enabled": true
    }
  }
}`,
  },
};

const configuration = configurations[client];
---

<Code code={configuration.code} lang={configuration.lang} />
