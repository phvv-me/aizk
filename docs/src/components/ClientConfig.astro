---
interface Props {
  client: 'claude-code' | 'codex' | 'opencode';
  shared?: boolean;
}

const { client, shared = false } = Astro.props;
const site = (Astro.site?.origin ?? 'https://aizk.example.com').replace(/\/$/, '');
const endpoint = `${site}/mcp`;
const clientId = import.meta.env.AIZK_DOCS_MCP_CLIENT_ID ?? 'PUBLIC_AIZK_CLIENT_ID';

const configurations = {
  'claude-code': shared
    ? `{
  "mcpServers": {
    "aizk": {
      "type": "http",
      "url": "${endpoint}",
      "oauth": {
        "clientId": "${clientId}",
        "callbackPort": 8912
      }
    }
  }
}`
    : `claude mcp add --scope user --transport http --client-id ${clientId} \\
  --callback-port 8912 aizk ${endpoint}
claude mcp login aizk`,
  codex: `mcp_oauth_credentials_store = "file"
mcp_oauth_callback_port = 8912

[features]
mcp_2026_07_28 = true

[mcp_servers.aizk]
url = "${endpoint}"
auth = "oauth"
scopes = ["control", "offline_access", "openid"]

[mcp_servers.aizk.oauth]
client_id = "${clientId}"`,
  opencode: `{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aizk": {
      "type": "remote",
      "url": "${endpoint}",
      "oauth": {
        "clientId": "${clientId}",
        "scope": "control offline_access openid",
        "callbackPort": 8912,
        "redirectUri": "http://127.0.0.1:8912/callback"
      },
      "enabled": true
    }
  }
}`,
};
---

<pre class="client-config"><code>{configurations[client]}</code></pre>

<style>
  .client-config {
    white-space: pre-wrap;
  }
</style>
