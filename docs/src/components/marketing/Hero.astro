---
const site = (Astro.site?.origin ?? 'https://YOUR_AIZK_HOST').replace(/\/$/, '');
const setupPrompt = `Set up AIZK for this project from ${site}`;
---

<section class="border-base-300 border-b">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 lg:grid-cols-2 lg:items-center lg:py-24">
    <div class="space-y-6">
      <div class="badge badge-outline badge-sm font-mono">sourced · scoped · MCP native</div>
      <h1
        class="text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
        style="font-family: var(--font-brand)"
      >
        One memory for you, your team and your agents
      </h1>
      <p class="text-base-content/70 max-w-xl text-lg text-pretty">
        aizk keeps what you and your agents learn and brings it back with its source and sharing
        boundary intact.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/docs/" class="btn btn-primary">Read the docs</a>
        <a href="https://github.com/phvv-me/aizk" class="btn btn-outline">View on GitHub</a>
      </div>
    </div>

    <aside class="border-base-300 bg-base-200 border p-6 sm:p-8" aria-labelledby="quickstart-title">
      <div class="mb-6">
        <p class="text-primary mb-2 font-mono text-xs font-semibold uppercase tracking-widest">
          Quickstart
        </p>
        <h2 id="quickstart-title" class="text-2xl font-semibold" style="font-family: var(--font-brand)">
          Ask your agent
        </h2>
      </div>

      <div class="space-y-4">
        <p class="text-base-content/65 text-sm">
          Send this instruction from the project where you want AIZK.
        </p>
        <pre class="border-base-300 bg-base-100 overflow-x-auto border p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap"><code data-setup-prompt>{setupPrompt}</code></pre>
        <p class="text-base-content/65 text-sm">
          Your agent handles setup and guides you through sign-in or account creation when needed.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <button type="button" class="btn btn-primary btn-sm" data-copy-setup>Copy instruction</button>
          <a href="/setup.md" class="link text-sm">Agent setup instructions</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-setup]');
  const prompt = document.querySelector<HTMLElement>('[data-setup-prompt]');

  button?.addEventListener('click', async () => {
    if (!prompt) return;
    await navigator.clipboard.writeText(prompt.textContent ?? '');
    button.textContent = 'Copied';
  });
</script>
