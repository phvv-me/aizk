---
const pillars = [
  {
    number: '01',
    title: 'Private by default',
    body: 'Your memory stays yours until you deliberately name who may share it.',
    href: '/docs/user/concepts/scopes/',
  },
  {
    number: '02',
    title: 'Sources stay attached',
    body: 'Every answer can show where it came from and what the system derived later.',
    href: '/docs/user/concepts/evidence/',
  },
  {
    number: '03',
    title: 'Portable by design',
    body: 'Five MCP tools keep the same shape across agents, teams and deployments.',
    href: '/docs/dev/run/databases/',
  },
];
---

<section class="border-base-300 border-b">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:py-28">
    <p class="text-primary mb-3 font-mono text-xs font-semibold uppercase tracking-[0.18em]">One memory</p>
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl" style="font-family: var(--font-brand)">
      Useful without losing context
    </h2>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        pillars.map((pillar) => (
          <a
            href={pillar.href}
            class="group border-base-300 bg-base-200/55 hover:bg-base-200 flex min-h-64 flex-col rounded-3xl border p-7 transition"
          >
            <span class="text-primary font-mono text-xs">{pillar.number}</span>
            <div class="mt-auto pt-16">
              <h3 class="text-xl font-semibold" style="font-family: var(--font-brand)">{pillar.title}</h3>
              <p class="text-base-content/65 mt-3 text-sm leading-relaxed">{pillar.body}</p>
              <span class="mt-5 inline-block text-sm font-medium group-hover:underline group-hover:underline-offset-4">
                Learn more
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
