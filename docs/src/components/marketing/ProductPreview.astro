<section id="product" class="border-base-300 border-b">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:py-28">
    <div class="mb-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-3xl">
        <p class="text-primary mb-3 font-mono text-xs font-semibold uppercase tracking-[0.18em]">
          See your memory
        </p>
        <h2
          class="max-w-2xl text-4xl leading-tight font-semibold tracking-[-0.035em] text-balance sm:text-5xl"
          style="font-family: var(--font-brand)"
        >
          Know what your agents know
        </h2>
        <p class="text-base-content/65 mt-5 max-w-2xl text-lg leading-relaxed">
          AIZK is more than a hidden vector index. Browse sources, inspect findings, follow subjects,
          watch processing and see how memory is being used.
        </p>
      </div>
      <a href="/app/dashboard" class="btn btn-outline">Open your dashboard</a>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-[#10182b] text-[#eef3ff] shadow-[0_32px_90px_rgba(23,34,59,0.24)]">
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
        <div class="flex items-center gap-3">
          <img src="/brain-box-icon.webp" alt="" class="size-8 rounded-lg" width="32" height="32" />
          <div>
            <p class="text-sm font-semibold">aizk</p>
            <p class="font-mono text-[10px] text-[#a9c5ff]/60">AI Zettelkasten</p>
          </div>
        </div>
        <div class="flex items-center gap-2 font-mono text-[10px] text-[#a9c5ff]/70">
          <span class="size-2 rounded-full bg-emerald-400"></span>
          memory live
        </div>
      </div>

      <div class="grid min-h-[42rem] md:grid-cols-[13rem_1fr]">
        <aside class="hidden border-r border-white/10 bg-[#17223b]/80 p-4 md:block">
          <nav class="space-y-6 text-sm" aria-label="Dashboard preview">
            <div>
              <p class="mb-2 px-3 font-mono text-[10px] uppercase tracking-widest text-[#a9c5ff]/45">Knowledge</p>
              <ul class="space-y-1">
                <li class="rounded-lg bg-[#315dff] px-3 py-2 font-medium">Dashboard</li>
                <li class="px-3 py-2 text-[#eef3ff]/60">Recall</li>
                <li class="px-3 py-2 text-[#eef3ff]/60">Explore</li>
                <li class="px-3 py-2 text-[#eef3ff]/60">Sources</li>
                <li class="px-3 py-2 text-[#eef3ff]/60">Findings</li>
                <li class="px-3 py-2 text-[#eef3ff]/60">Subjects</li>
                <li class="px-3 py-2 text-[#eef3ff]/60">Themes</li>
              </ul>
            </div>
            <div>
              <p class="mb-2 px-3 font-mono text-[10px] uppercase tracking-widest text-[#a9c5ff]/45">Operations</p>
              <ul class="space-y-1 text-[#eef3ff]/60">
                <li class="px-3 py-2">Usage</li>
                <li class="px-3 py-2">Processing</li>
              </ul>
            </div>
          </nav>
        </aside>

        <div class="min-w-0 p-5 sm:p-7">
          <div class="mb-7">
            <p class="text-2xl font-semibold tracking-tight">Dashboard</p>
            <p class="mt-1 text-sm text-[#eef3ff]/50">Your memory at a glance</p>
          </div>

          <div class="grid grid-cols-2 gap-3 lg:grid-cols-5">
            {
              [
                ['Documents', '87'],
                ['Files', '12'],
                ['Findings', '184'],
                ['Subjects', '61'],
                ['Themes', '9'],
              ].map(([label, value]) => (
                <div class="rounded-xl border border-white/10 bg-white/[0.035] p-4">
                  <p class="text-xs text-[#eef3ff]/50">{label}</p>
                  <p class="mt-2 text-2xl font-semibold">{value}</p>
                </div>
              ))
            }
          </div>

          <div class="mt-4 grid gap-4 xl:grid-cols-[1.4fr_1fr]">
            <section class="rounded-xl border border-white/10 bg-white/[0.035] p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="font-semibold">Memory activity</h3>
                  <p class="mt-1 text-xs text-[#eef3ff]/45">Remember, find and share</p>
                </div>
                <span class="rounded-full border border-white/10 px-2 py-1 font-mono text-[9px] text-[#a9c5ff]/70">30 days</span>
              </div>
              <svg viewBox="0 0 620 190" class="mt-6 w-full" role="img" aria-label="Memory activity trending upward">
                <defs>
                  <linearGradient id="activity-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#7598ff" stop-opacity=".38"></stop>
                    <stop offset="1" stop-color="#7598ff" stop-opacity="0"></stop>
                  </linearGradient>
                </defs>
                <g stroke="white" stroke-opacity=".08">
                  <line x1="0" y1="35" x2="620" y2="35"></line>
                  <line x1="0" y1="95" x2="620" y2="95"></line>
                  <line x1="0" y1="155" x2="620" y2="155"></line>
                </g>
                <path d="M0 155 C62 150 72 110 125 120 S210 73 265 94 S348 42 410 68 S500 32 620 38 L620 190 L0 190 Z" fill="url(#activity-fill)"></path>
                <path d="M0 155 C62 150 72 110 125 120 S210 73 265 94 S348 42 410 68 S500 32 620 38" fill="none" stroke="#a9c5ff" stroke-width="4" stroke-linecap="round"></path>
                <circle cx="620" cy="38" r="6" fill="#ff6b4a" stroke="#10182b" stroke-width="3"></circle>
              </svg>
            </section>

            <section class="rounded-xl border border-white/10 bg-white/[0.035] p-5">
              <h3 class="font-semibold">Processing</h3>
              <p class="mt-1 text-xs text-[#eef3ff]/45">Sources stay usable while enrichment continues</p>
              <div class="mt-8 space-y-7">
                <div>
                  <div class="mb-2 flex justify-between text-xs"><span>Source conversion</span><span class="text-emerald-300">complete</span></div>
                  <div class="h-2 overflow-hidden rounded-full bg-white/10"><div class="h-full w-full rounded-full bg-emerald-400"></div></div>
                </div>
                <div>
                  <div class="mb-2 flex justify-between text-xs"><span>Graph enrichment</span><span class="text-[#a9c5ff]">84%</span></div>
                  <div class="h-2 overflow-hidden rounded-full bg-white/10"><div class="h-full w-[84%] rounded-full bg-[#7598ff]"></div></div>
                </div>
              </div>
            </section>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <section class="rounded-xl border border-white/10 bg-white/[0.035] p-5">
              <h3 class="font-semibold">Recent sources</h3>
              <ul class="mt-4 divide-y divide-white/10 text-sm">
                <li class="flex items-center justify-between gap-4 py-3"><span>Retrieval design notes</span><span class="font-mono text-[10px] text-[#a9c5ff]/60">private</span></li>
                <li class="flex items-center justify-between gap-4 py-3"><span>Interface guidelines</span><span class="font-mono text-[10px] text-[#a9c5ff]/60">Design</span></li>
                <li class="flex items-center justify-between gap-4 py-3"><span>Release checklist</span><span class="font-mono text-[10px] text-[#a9c5ff]/60">Engineering</span></li>
              </ul>
            </section>
            <section class="relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.035] p-5">
              <h3 class="font-semibold">Connected knowledge</h3>
              <p class="mt-1 text-xs text-[#eef3ff]/45">Subjects remain linked to their evidence</p>
              <svg viewBox="0 0 420 150" class="mt-2 w-full" role="img" aria-label="A small connected knowledge graph">
                <g stroke="#a9c5ff" stroke-opacity=".32" stroke-width="2">
                  <line x1="78" y1="92" x2="197" y2="50"></line>
                  <line x1="197" y1="50" x2="326" y2="84"></line>
                  <line x1="197" y1="50" x2="230" y2="128"></line>
                  <line x1="78" y1="92" x2="230" y2="128"></line>
                </g>
                <g fill="#7598ff" stroke="#10182b" stroke-width="5">
                  <circle cx="78" cy="92" r="18"></circle>
                  <circle cx="197" cy="50" r="24"></circle>
                  <circle cx="326" cy="84" r="16"></circle>
                  <circle cx="230" cy="128" r="14"></circle>
                </g>
                <circle cx="197" cy="50" r="7" fill="#ff6b4a"></circle>
              </svg>
            </section>
          </div>
        </div>
      </div>
    </div>
    <p class="text-base-content/45 mt-4 text-center font-mono text-[10px]">
      Illustrative data. Your dashboard is built from the memory visible to your account.
    </p>
  </div>
</section>
