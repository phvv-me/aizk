---
import { supportedClients } from '../config/setup';

const clients = [
  ...supportedClients().map((client) => ({
    ...client,
    command: `${client.install}\n${client.connect}`,
  })),
  {
    id: 'opencode',
    label: 'OpenCode',
    href: '/docs/user/clients/opencode/',
    command: null,
    note: 'OpenCode still uses the manual remote MCP configuration.',
  },
];
---

<div class="setup-chooser">
  <p class="setup-intro">Choose your client and install AIZK from its plugin marketplace.</p>
  <div class="setup-options">
    {
      clients.map((client, index) => (
        <details name="aizk-client" open={index === 0}>
          <summary>{client.label}</summary>
          <div class="setup-panel">
            <p class="setup-note">{client.note}</p>
            {client.command && <pre><code>{client.command}</code></pre>}
            <div class="setup-actions">
              {client.command && <button type="button" data-copy={client.command}>Copy commands</button>}
              <a href={client.href}>{client.command ? 'Detailed setup' : 'Open manual setup'}</a>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</div>

<script>
  import { copyText } from '../scripts/copy';

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      button.textContent = (await copyText(button.dataset.copy ?? '')) ? 'Copied' : 'Select the text';
    });
  });
</script>

<style>
  .setup-chooser {
    display: grid;
    gap: 1rem;
  }

  .setup-intro {
    margin: 0;
    color: color-mix(in srgb, currentColor 70%, transparent);
  }

  .setup-options {
    display: grid;
    gap: 0.5rem;
  }

  details {
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    background: color-mix(in srgb, currentColor 4%, transparent);
  }

  summary {
    cursor: pointer;
    padding: 0.75rem 1rem;
    font-weight: 700;
  }

  details[open] summary {
    color: #315dff;
    border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }

  .setup-panel {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }

  .setup-note {
    margin: 0;
    color: color-mix(in srgb, currentColor 70%, transparent);
    font-size: 0.875rem;
  }

  pre {
    max-width: 100%;
    margin: 0;
    overflow-x: auto;
    padding: 1rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
    white-space: pre-wrap;
  }

  code {
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .setup-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  button {
    border: 1px solid #315dff;
    padding: 0.5rem 0.75rem;
    background: #315dff;
    color: white;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  a {
    color: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
