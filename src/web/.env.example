# Same AIZK_* names the Python settings use; values live in the deployment env.
AIZK_LOGTO_URL=https://auth.example.com
AIZK_WEB_CLIENT_ID=
AIZK_WEB_CLIENT_SECRET=
AIZK_WEB_PUBLIC_URL=https://aizk.example.com
AIZK_WEB_SESSION_SECRET=
AIZK_WEB_API_URL=https://aizk.example.com
AIZK_MCP_PUBLIC_URL=https://aizk.example.com
# adapter-node caps request bodies at 512K by default. Uploads proxy through the
# server, so raise this to the intake byte limit.
BODY_SIZE_LIMIT=100M
