    {
      "type": "timeseries",
      "title": "Output token spend by user",
      "description": "A TraceQL metrics query summing the token counts the GenAI spans carry, grouped by the caller. This is per-user token spend read straight off the traces.",
      "datasource": {
        "type": "tempo",
        "uid": "aizk-traces"
