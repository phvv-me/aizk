{
  "uid": "aizk-overview",
  "title": "AIZK overview",
  "description": "What the system served, who asked for it, what it called to answer, and what that cost. Every series here is derived from the same spans, so any panel can be opened into the exact traces behind it.",
  "tags": [
    "aizk"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "What the system is serving",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by operation",
      "description": "Server spans grouped by the operation the MCP or API middleware annotated.",
      "datasource": {
        "type": "prometheus",
        "uid": "aizk-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aizk-metrics"
          },
          "expr": "sum by (aizk_operation) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{aizk_operation}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency by operation",
      "description": "p50 and p95 from the Tempo span metrics histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "aizk-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aizk-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, aizk_operation) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "p95 {{aizk_operation}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "aizk-metrics"
          },
          "expr": "histogram_quantile(0.5, sum by (le, aizk_operation) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "p50 {{aizk_operation}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failing requests by operation",
      "description": "Spans that ended in an error status, which is the honest failure count.",
