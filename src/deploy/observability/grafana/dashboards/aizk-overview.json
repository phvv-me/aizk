          },
          "expr": "sum by (aizk_operation) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{aizk_operation}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
