:8081 {
	encode zstd gzip

	@mcp path /mcp /mcp/* /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp /authorize /token /register /auth/callback /consent
	handle @mcp {
		reverse_proxy server:8080
	}

	@upload {
		method PUT
		path /api/uploads/*
	}
	handle @upload {
		reverse_proxy api:8010
	}

	@api path /api /api/*
	handle @api {
		respond 404
	}

	header {
		Referrer-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}

	# SvelteKit owns a closed set of paths: the signed-in application, the browser sign-in flow
	# that is not the MCP server's own callback above, its event stream, and its build assets.
	# Everything else, including every documentation page ever added, is the static site, so a
	# new docs page never needs a routing change here.
	@app path /app /app/* /auth/* /events/* /_app/*
	handle @app {
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy docs:8082
	}
}

# The operator console, a second site in the same container that Cloudflare reaches at web:8082.
# It is one hostname with paths rather than a name per tool because Cloudflare's free Universal
# SSL certificate covers only first-level subdomains, so `observability.admin.phvv.me` would need
# a paid certificate while `admin.phvv.me/grafana` costs nothing. The port collides with nothing,
# since the 8082 the last rule above dials belongs to the separate `docs` container.
:8082 {
	encode zstd gzip

	# Identity arrives only from the gate below, so any inbound claim of one is stripped first.
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups

	header {
		Referrer-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}

	# The sign-in redirect, the Logto callback, and the sign-out endpoint belong to the proxy.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	handle {
		# Every remaining path is authorized first. oauth2-proxy answers 202 for a session that
		# carries the operator role and 401 for anything else, which starts the Logto sign-in and
		# returns to the page that was asked for.
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups

			# The return address is spelled https by hand. This site only ever hears plain HTTP,
			# since TLS terminates at Cloudflare, so `{scheme}` would build an http return that
			# the Secure session cookie is not sent on, and the sign-in would loop forever.
			@unauthorized status 401
			handle_response @unauthorized {
				redir * /oauth2/sign_in?rd=https://{host}{uri}
			}
		}

		# `/console` does not say which tool it is, so `/logto` is an alias onto it rather than a
		# rename. The console's assets are built with the `/console` prefix compiled in, so the
		# real path cannot move, and `/auth` is unavailable because the SvelteKit app owns it.
		# `handle_path` rather than `handle` plus `uri strip_prefix`, because Caddy orders `redir`
		# ahead of `uri`, so the strip would run after the redirect had already read `{uri}` and
		# the alias would send `/logto/x` to `/console/logto/x`.
		handle_path /logto* {
			redir * /console{uri} 302
		}

		# Logto's console is already a path-based app on its own port, so it joins the console
		# host rather than taking a second hostname. `/api` is the management API the console
		# calls and `/me` is its account app, and neither collides here, since the browser never
		# calls them. The SvelteKit client that owns `/api` paths runs server side against the
		# api container instead. Logto already names this origin as its admin endpoint, so its
		# redirect URIs and CORS need no change, and reaching it through this block puts it
		# behind the operator gate too.
		handle /console* {
			reverse_proxy logto:3002
		}

		handle /api/* {
			reverse_proxy logto:3002
		}

		handle /me* {
			reverse_proxy logto:3002
		}

		# Grafana serves the subpath itself, so the prefix is forwarded rather than stripped.
		handle /grafana/* {
			reverse_proxy grafana:3000
		}

		# Traces live in Tempo, which ships no UI of its own on purpose, because Grafana is the
		# single pane. `/traces` therefore stays a readable address that opens Grafana's trace
		# explorer on the Tempo data source rather than a second tool to sign in to. It is
		# wrapped in `handle` so it sorts with its siblings and stays behind the gate above,
		# since a bare `redir` is ordered ahead of `forward_auth` and would answer anonymously.
		handle /traces {
			redir * /grafana/explore?schemaVersion=1&orgId=1&panes=%7B%22aizk%22%3A%7B%22datasource%22%3A%22aizk-traces%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22aizk-traces%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%22%7D%5D%7D%7D 302
		}

		# This host's root is the operator console. A bare `/` here serves the console itself
		# rather than redirecting or answering 404, and the product application keeps its own
		# hostname, so the two faces never compete for a path. Every named tool above is a
		# more specific matcher, and Caddy sorts `handle` blocks by specificity, so this
		# catch-all cannot shadow them however it is ordered in the file.
		#
		# The operator pages are a separate future build inside this same SvelteKit app. Until
		# they exist a bare `/` lands on the app's own root. Teaching it which face to present
		# needs a host hint rather than a routing change here, either passing the console
		# hostname through as a header the app reads, or giving the app a dedicated base path.
		# Neither is built yet and neither belongs in this file.
		handle {
			reverse_proxy frontend:3000
		}
	}
}
